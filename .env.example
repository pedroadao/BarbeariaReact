VITE_API_BASE_URL=http://localhost:5207
# Se a API estiver rodando via docker compose (ver Barbearia/docker-compose.yml),
# use a porta publicada em API_PORT, por exemplo http://localhost:8081.

# URL do projeto Authentication (provedor OIDC usado para login). Ajuste a porta
# conforme Authentication/src/API/Properties/launchSettings.json.
VITE_AUTH_BASE_URL=https://localhost:7179
# client_id público (sem segredo) registrado em Authentication/src/API/Startup/DevelopmentSeed.cs
# para este frontend, com redirect_uri = VITE_OIDC_REDIRECT_URI.
VITE_OIDC_CLIENT_ID=barbearia-spa-client
VITE_OIDC_REDIRECT_URI=http://localhost:5174/callback
VITE_OIDC_SCOPE=openid email profile offline_access
